+// -- Sigil Neon layout profile -----------------------------------------------
+
+/// Reshape the appearance config for the Sigil Neon theme.
+///
+/// The theme is not only a palette. Sigil Neon is a layout: no filled cards in
+/// the transcript, wider outer margins, the smallest bullet in the set, and a
+/// shell-style command header — so the transcript reads as a document with
+/// marks in the margin instead of a stack of panels. Every other theme is
+/// returned untouched.
+pub fn apply_sigil_profile(mut config: AppearanceConfig) -> AppearanceConfig {
+    if crate::theme::Theme::current_kind() != crate::theme::ThemeKind::SigilNeon {
+        return config;
+    }
+    // The user's turn is marked by a rule and a label, not by a filled card.
+    config.scrollback.blocks.prompt.bg = BlockBackground::None;
+    config.scrollback.blocks.prompt.show_prefix = false;
+    config.scrollback.blocks.prompt.vpad = true;
+    // Margins wide enough that the marks in the left column read as a margin.
+    config.scrollback.layout.outer_hpad_left = 4;
+    config.scrollback.layout.outer_hpad_right = 3;
+    config.scrollback.layout.block_pad_left = 1;
+    config.scrollback.layout.block_pad_right = 1;
+    // One dot per tool call. The diamond was the loudest glyph on the screen.
+    config.scrollback.blocks.tool.bullet = ToolBullet::Dot;
+    config.scrollback.blocks.tool.dim_details = true;
+    // A shell command should look like one.
+    config.scrollback.blocks.execute.header_style = ExecuteHeaderStyle::Shell;
+    // Reasoning is an aside: no header emphasis, and it stays out of the way.
+    config.scrollback.blocks.thinking.header_bright = false;
+    config.scrollback.blocks.list_dir.terminal_bg = false;
+    config.scrollback.display.collapsed_accent_char = "\u{2502}".to_string();
+    config.scrollback.display.expandable_indicator_char = "\u{203A}".to_string();
+    config
+}
