@@ -0,0 +1,143 @@
+use ratatui::style::{Color, Modifier};
+
+use super::tokyonight::Theme;
+
+const fn rgb(r: u8, g: u8, b: u8) -> Color {
+    Color::Rgb(r, g, b)
+}
+
+/// Sigil Neon palette.
+///
+/// A near-black neutral ground with a two-hue neon accent family: mint for
+/// the agent's own voice and success, cyan for anything in motion (running
+/// tools, links, the model name). Violet marks the human's turn, amber is
+/// reserved for commands and warnings, and magenta for failure.
+///
+/// The rule that keeps it "subtle": the ground and every chrome grey are
+/// neutral — no hue at all — so the neon only ever appears on the small
+/// marks that carry state. Text is a cool near-white, never a neon colour.
+#[allow(dead_code)]
+mod palette {
+    use super::*;
+
+    // -- neutral ground ramp (no hue; the neon must never smear) -------------
+    pub const BASE: Color = rgb(8, 9, 11); // #08090B — the ground
+    pub const SURFACE: Color = rgb(12, 13, 16); // #0C0D10 — code blocks, paste
+    pub const ELEVATED: Color = rgb(20, 22, 26); // #14161A — highlight rows
+    pub const HOVER: Color = rgb(26, 29, 35); // #1A1D23 — mouse hover
+    pub const VISUAL: Color = rgb(31, 36, 44); // #1F242C — visual selection
+
+    // -- text ramp (cool neutral, three discrete steps) ----------------------
+    pub const TEXT: Color = rgb(230, 233, 239); // #E6E9EF — primary
+    pub const TEXT_DIM: Color = rgb(184, 191, 203); // #B8BFCB — secondary
+    pub const MUTED: Color = rgb(122, 130, 143); // #7A828F — meta text
+    pub const SUBTLE: Color = rgb(80, 88, 100); // #505864 — dimmest meta
+
+    // -- chrome lines (neutral, one step apart) ------------------------------
+    pub const LINE_LOW: Color = rgb(23, 26, 31); // #171A1F — scrollbar track
+    pub const LINE: Color = rgb(37, 42, 50); // #252A32 — idle borders
+    pub const LINE_HIGH: Color = rgb(56, 63, 74); // #383F4A — selection borders
+
+    // -- neon accents (small marks only) -------------------------------------
+    pub const MINT: Color = rgb(78, 240, 196); // #4EF0C4 — assistant, success
+    pub const MINT_DIM: Color = rgb(45, 138, 116); // #2D8A74 — idle prompt edge
+    pub const CYAN: Color = rgb(90, 217, 255); // #5AD9FF — running, links
+    pub const VIOLET: Color = rgb(169, 139, 255); // #A98BFF — the human's turn
+    pub const VIOLET_DIM: Color = rgb(104, 86, 158); // #68569E — thinking
+    pub const AMBER: Color = rgb(255, 196, 107); // #FFC46B — commands, warnings
+    pub const MAGENTA: Color = rgb(255, 95, 158); // #FF5F9E — failure
+    pub const LIME: Color = rgb(124, 255, 178); // #7CFFB2 — remember mode
+}
+use palette::*;
+
+impl Theme {
+    /// Sigil Neon — the theme the Sigil app ships with.
+    pub const fn sigil() -> Self {
+        Self {
+            bg_base: BASE,
+            bg_light: ELEVATED,
+            bg_dark: SURFACE,
+            bg_highlight: ELEVATED,
+            bg_hover: HOVER,
+            bg_terminal: SURFACE,
+
+            accent_user: VIOLET,
+            accent_assistant: MINT,
+            accent_thinking: VIOLET_DIM,
+            accent_tool: SUBTLE,
+            accent_system: CYAN,
+            accent_error: MAGENTA,
+            accent_success: MINT,
+            accent_running: CYAN,
+            accent_skill: MINT_DIM,
+
+            text_primary: TEXT,
+            text_secondary: TEXT_DIM,
+
+            gray_dim: SUBTLE,
+            gray: MUTED,
+            gray_bright: TEXT_DIM,
+
+            command: AMBER,
+            path: CYAN,
+            running: CYAN,
+            warning: AMBER,
+
+            fuzzy_accent: MINT,
+
+            accent_plan: AMBER,
+
+            accent_verify: VIOLET,
+
+            accent_remember: LIME,
+
+            // The prompt is the one place the neon touches chrome: a dim mint
+            // edge at rest that lights to full mint while the box has focus.
+            selection_border: LINE_HIGH,
+            hover_border: LINE,
+            prompt_border: LINE,
+            prompt_border_active: MINT_DIM,
+
+            accent_model: MINT,
+
+            // The thumb has to sit clearly above the track at this ground
+            // brightness, so it steps to the chrome line, not to a fill.
+            scrollbar_bg: LINE_LOW,
+            scrollbar_fg: LINE_HIGH,
+
+            diff_delete_bg: rgb(43, 12, 26),
+            diff_delete_fg: MAGENTA,
+            diff_insert_bg: rgb(6, 38, 32),
+            diff_insert_fg: MINT,
+            diff_equal_fg: MUTED,
+            diff_gutter_fg: SUBTLE,
+
+            bg_visual: VISUAL,
+
