+/// Sigil Neon replaces the braille art with a wordmark.
+///
+/// The art is a picture of a brand. A wordmark, one rule, and the product name
+/// under it say the same thing in three rows and leave the screen quiet.
+fn sigil_wordmark() -> bool {
+    crate::theme::Theme::current_kind() == crate::theme::ThemeKind::SigilNeon
+}
+
+/// Columns the wordmark occupies: `S I G I L` is 9 cells.
+const WORDMARK: &str = "S I G I L";
+const WORDMARK_RULE: &str = "\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}";
+const WORDMARK_SUB: &str = "grok build";
+const WORDMARK_WIDTH: u16 = 10;
+const WORDMARK_ROWS: u16 = 3;
+
+fn render_wordmark(area: Rect, buf: &mut Buffer, theme: &Theme) {
+    if area.height == 0 || area.width == 0 {
+        return;
+    }
+    // The shine still sweeps, so the mark breathes like the art it replaces.
+    let shine = shine_opacity(0.5, anim_phase_secs());
+    let mark = blend_color(theme.gray_bright, theme.logo_shine, shine.max(0.35))
+        .unwrap_or(theme.logo_shine);
+    let rows = [
+        (WORDMARK, Style::default().fg(mark).add_modifier(ratatui::style::Modifier::BOLD)),
+        (WORDMARK_RULE, Style::default().fg(theme.logo_shine)),
+        (WORDMARK_SUB, Style::default().fg(theme.gray)),
+    ];
+    let top = area.y + area.height.saturating_sub(WORDMARK_ROWS) / 2;
+    for (i, (text, style)) in rows.iter().enumerate() {
+        let y = top + i as u16;
+        if y >= area.y + area.height {
+            break;
+        }
+        let w = unicode_width::UnicodeWidthStr::width(*text) as u16;
+        let x = area.x + area.width.saturating_sub(w) / 2;
+        buf.set_string(x, y, *text, *style);
+    }
+}
